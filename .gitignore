# Secrets (API keys); commit the *.example files instead
firmware/**/secrets.h
ios/**/Secrets.xcconfig
ios/**/Secrets.plist

# Build output
# ESP-IDF: generated per-env configs and downloaded components (sdkconfig.defaults is tracked)
firmware/**/sdkconfig.*
!firmware/**/sdkconfig.defaults
firmware/**/managed_components/
.pio/
build/
DerivedData/
xcuserdata/
.build/
.swiftpm/
*.xcuserstate
__pycache__/

# Local tooling and OS files
CLAUDE.md
.claude/
.DS_Store

# Downloaded GTFS feed (tools/gtfs_build.py input)
data/gtfs/

# Sprite previews (tools/sprite_build.py output)
art/build/

# OpenStreetMap download cache (tools/basemap_build.py input)
data/osm/

# ESP-IDF builds (sdkconfig.defaults is the source; the rest is generated)
firmware/**/sdkconfig.*
!firmware/**/sdkconfig.defaults
firmware/**/managed_components/
